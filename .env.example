# ─────────────────────────────────────────────────────────────────────────────
# Agentic NL2SQL — environment variables. Copy to .env.local and fill in.
# ALL of these are server-side only. None use the NEXT_PUBLIC_ prefix, so nothing
# here is ever sent to the browser. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres or any PostgreSQL 15+ with pgvector) ─────────
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543) is
# recommended on Vercel. Local Docker example: postgresql://postgres:postgres@127.0.0.1:54329/nl2sql
DATABASE_URL=

# Optional but recommended: a login that is ONLY the nl2sql_readonly role (see docs/DEPLOYMENT.md).
# If unset, the app runs `SET LOCAL ROLE nl2sql_readonly` inside a READ ONLY transaction instead.
READONLY_DATABASE_URL=

# ── LLM provider (any OpenAI-compatible chat API) ────────────────────────────
# AI_PROVIDER: openrouter | openai | groq | gemini | ollama | custom
AI_PROVIDER=openrouter
AI_MODEL=
AI_API_KEY=
# Only needed for AI_PROVIDER=custom (or to override a preset), e.g. http://localhost:11434/v1
AI_BASE_URL=

# ── Embeddings for vector search (optional — lexical retrieval is used when unset) ───
# Must produce 768-dimensional vectors (or support the `dimensions` parameter). After setting this,
# run `npm run metadata:embed` once. May use a different provider/key than the chat model.
EMBEDDING_MODEL=
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ── Optional tuning (defaults shown) ─────────────────────────────────────────
# MAX_ROWS=200                # rows returned to the UI
# QUERY_TIMEOUT_MS=8000       # per-query statement timeout
# MAX_SQL_ATTEMPTS=3          # 1 generation + up to 2 self-corrections
# MAX_QUESTION_LENGTH=500
# RATE_LIMIT_PER_MINUTE=12    # per client, DB-backed
# AI_TIMEOUT_MS=45000
# AI_MAX_RETRIES=1            # retries on 429 / 5xx / timeouts
# ANALYSIS_MODE=llm           # llm | rules  (rules skips the analysis LLM call: cheaper, less accurate scope check)
# SUMMARY_MODE=llm            # llm | deterministic (deterministic skips the summary LLM call). Built-in demo only: uploaded datasets always use
#                             # the locally built summary, so result rows of uploaded data are never sent to the model.
# RATE_LIMIT_SALT=change-me   # salt for hashing client IPs
# DATASET_MAX_ROWS=50000      # user-uploaded datasets: total rows (see docs/DATASET_UPLOAD.md)
# DATASET_TTL_HOURS=72        # user-uploaded datasets are deleted after this many hours
# SEED_ANCHOR_DATE=2026-09-21 # last day of seeded data (default: today)
